# Mordor Testnet Configuration
ETHEREUM_CHAIN_ID=63

# PostgreSQL Configuration
POSTGRES_USER=safe
POSTGRES_PASSWORD=safe
POSTGRES_DB=safe

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=safe
RABBITMQ_DEFAULT_PASS=safe

# Safe Transaction Service Configuration
# SECURITY WARNING: Generate a strong random secret key for production!
# You can generate one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=changeme-use-strong-secret-key-in-production

# SECURITY WARNING: Restrict to specific domains in production (e.g., DJANGO_ALLOWED_HOSTS=example.com,localhost)
DJANGO_ALLOWED_HOSTS=*
DEBUG=False

# Ethereum Node URLs
ETHEREUM_NODE_URL=http://mordor-node:8545
ETHEREUM_TRACING_NODE_URL=http://mordor-node:8545

# Safe Contract Configuration (optional - set if deploying Safe contracts)
SAFE_CONTRACT_ADDRESS=
SAFE_FUNDER_PRIVATE_KEY=

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# IPFS Configuration
IPFS_PROFILE=server
